<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head'); %>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts para tipografía elegante -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    
    <style>
        :root {
            --color-primary: #e05696;     /* Rosa vibrante principal */
            --color-primary-dark: #b83b77;/* Rosa más oscuro para hover */
            --color-soft-pink: #fdf2f7;   /* Fondo sutil rosado */
            --color-rose-gold: #c58371;   /* Toque elegante secundario */
            --color-dark: #2b2b2b;        /* Texto principal elegante */
            --color-light: #ffffff;
        }

        body {
            background-color: var(--color-light);
            color: var(--color-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* Hero sección con imagen de fondo difusa más clara */
        .hero-section {
            position: relative;
            background: url('/img/bienvenida.jpg') center/cover no-repeat;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            background: url('/img/bienvenida.jpg') center/cover no-repeat;
            filter: blur(8px);
            z-index: 1;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(253, 240, 245, 0.82) 100%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
        }

        /* Efecto Zoom Suave en Imágenes de Servicios */
        .hover-zoom {
            overflow: hidden;
            border-radius: 1.25rem;
        }
        .hover-zoom img {
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hover-zoom:hover img {
            transform: scale(1.05);
        }

        /* TARJETAS DE SERVICIOS DESTACADOS (Efecto Rosa Destacado) */
        .service-card {
            background: #ffffff !important;
            border: 2px solid #f7e9f0 !important;
            border-radius: 1.25rem !important;
            box-shadow: 0 0.5rem 1.25rem rgba(224, 86, 150, 0.08) !important;
            transition: all 0.4s ease !important;
        }

        .service-card:hover {
            transform: translateY(-8px) !important;
            border-color: var(--color-primary) !important;
            background-color: #fff9fc !important;
            box-shadow: 0 1rem 2.5rem rgba(224, 86, 150, 0.25) !important;
        }

        .card-clean {
            background: #fff9fc;
            border: 1px solid rgba(224, 86, 150, 0.18);
            border-radius: 1.25rem;
            box-shadow: 0 0.75rem 1.5rem rgba(224, 86, 150, 0.06);
            transition: all 0.4s ease;
        }

        .card-clean:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 2rem rgba(224, 86, 150, 0.12);
        }

        .benefit-card {
            border: 2px solid transparent !important;
            transition: all 0.4s ease !important;
        }

        .benefit-card:hover {
            transform: translateY(-8px) !important;
            border-color: var(--color-primary) !important;
            background-color: #fff9fc !important;
            box-shadow: 0 1rem 2.5rem rgba(224, 86, 150, 0.2) !important;
        }

        .benefit-card:hover .text-pink {
            transform: scale(1.1);
            transition: transform 0.3s ease;
        }

        .btn-pink {
            background-color: var(--color-primary);
            border: none;
            color: white;
            transition: all 0.3s ease;
        }
        .btn-pink:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(224, 86, 150, 0.3);
            color: white;
        }

        .btn-outline-pink {
            border: 2px solid var(--color-primary);
            color: var(--color-primary);
            background: transparent;
            transition: all 0.3s ease;
        }
        .btn-outline-pink:hover {
            border: 2px solid var(--color-primary);
            background-color: transparent;
            color: var(--color-primary);
            transform: translateY(-2px);
        }

        .text-pink {
            color: var(--color-primary);
        }

        .bg-soft {
            background-color: var(--color-soft-pink);
        }

        .form-control-clean {
            background-color: #faf6f8;
            border: 1px solid #e8d7e0;
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .form-control-clean:focus {
            background-color: #ffffff;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 4px rgba(224, 86, 150, 0.15);
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Header integrado directamente sin bordes blancos superiores -->
    <%- include('../partials/header'); %>

    <!-- Main Content -->
    <main class="flex-grow-1">
        
        <!-- Hero Section -->
        <section class="hero-section py-5 py-lg-6 text-center">
            <div class="container py-5 hero-content">
                <div class="row justify-content-center align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-white text-pink border border-pink-subtle px-4 py-2 rounded-pill mb-4 shadow-sm fw-semibold text-uppercase tracking-wider">
                            Salón & Estética Exclusiva
                        </span>
                        
                        <h1 class="display-3 fw-bold text-dark mb-4 hover-title">
                            Haz de tu Cabello, tu Mejor <span class="text-pink">ACCESORIO</span>
                        </h1>
                        
                        <p class="lead text-muted mb-5">Atención personalizada, tendencias de alta costura capilar y un ambiente de paz pensado exclusivamente en tu bienestar.</p>
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="/api/v1/catalogo" class="btn btn-pink btn-lg px-5 py-3 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-stars me-2"></i> Ver Catálogo
                            </a>
                            <a href="#contacto" class="btn btn-outline-pink btn-lg px-4 py-3 rounded-pill fw-semibold">
                                Reservar Cita
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Servicios Destacados -->
        <section class="container py-5 my-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold display-6 mb-2"><span class="text-pink">Servicios Destacados</span></h2>
                <p class="text-muted">Diseñados para transformar tu imagen con sofisticación</p>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-md-4">
                    <div class="card service-card h-100 overflow-hidden">
                        <div class="hover-zoom p-3 pb-0">
                            <img src="/img/service1.jpg" class="w-100 object-fit-cover rounded-4" style="height: 240px;" alt="Corte y Estilo">
                        </div>
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold text-dark mb-2">Corte & Estilo</h4>
                            <p class="text-muted small mb-0">Cortes vanguardistas que armonicen perfectamente con la simetría de tu rostro.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card h-100 overflow-hidden">
                        <div class="hover-zoom p-3 pb-0">
                            <img src="/img/service2.jpg" class="w-100 object-fit-cover rounded-4" style="height: 240px;" alt="Coloración">
                        </div>
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold text-dark mb-2">Coloración Avanzada</h4>
                            <p class="text-muted small mb-0">Técnicas de iluminaciones, balayage y tonalidades sutiles de alto brillo.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card h-100 overflow-hidden">
                        <div class="hover-zoom p-3 pb-0">
                            <img src="/img/service3.jpg" class="w-100 object-fit-cover rounded-4" style="height: 240px;" alt="Tratamientos Capilares">
                        </div>
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold text-dark mb-2">Tratamientos Capilares</h4>
                            <p class="text-muted small mb-0">Protocolos profundos de nutrición, hidratación y reconstrucción absoluta.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón de Catálogo Central -->
            <div class="text-center mt-5">
                <a href="/api/v1/catalogo" class="btn btn-outline-pink btn-lg px-5 py-3 rounded-pill fw-bold shadow-sm">
                    Explorar Catálogo Completo <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </section>

        <!-- Sección Beneficios: Por Qué Elegirnos -->
        <section class="bg-soft py-5 border-top border-bottom border-light">
            <div class="container py-4">
                <div class="row text-center mb-5">
                    <div class="col">
                        <h2 class="fw-bold"><span class="text-pink">¿Por Qué Elegirnos?</span></h2>
                        <p class="text-muted">Comprometidos con la excelencia y tu satisfacción total</p>
                    </div>
                </div>
                <div class="row g-4 text-center">
                    <div class="col-md-4">
                        <div class="benefit-card p-4 bg-white rounded-4 shadow-sm h-100">
                            <div class="text-pink fs-1 mb-3"><i class="bi bi-flower1"></i></div>
                            <h4 class="fw-bold text-dark h5">Expertos en Estética</h4>
                            <p class="text-muted small mb-0">Profesionales apasionados por el diseño de imagen y el cuidado capilar detallado.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="benefit-card p-4 bg-white rounded-4 shadow-sm h-100">
                            <div class="text-pink fs-1 mb-3"><i class="bi bi-shield-check"></i></div>
                            <h4 class="fw-bold text-dark h5">Productos Exclusivos</h4>
                            <p class="text-muted small mb-0">Fórmula de alta gama para asegurar la salud y vitalidad natural de tu cabello.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="benefit-card p-4 bg-white rounded-4 shadow-sm h-100">
                            <div class="text-pink fs-1 mb-3"><i class="bi bi-heart"></i></div>
                            <h4 class="fw-bold text-dark h5">Ambiente Acogedor</h4>
                            <p class="text-muted small mb-0">Un espacio íntimo, moderno y diseñado para desconectar de la rutina diaria.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección de Contacto / Ubicación -->
        <section id="contacto" class="container py-5 my-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="text-pink fw-bold text-uppercase small tracking-wider">Hablemos</span>
                    <h2 class="fw-bold mb-3 mt-1">Visítanos o <span class="text-pink">Reserva Tu Cita</span></h2>
                    <p class="text-muted mb-4">¿Lista para un cambio transformador? Escríbenos directamente o visítanos en nuestro estudio.</p>
                    <ul class="list-unstyled text-dark">
                        <li class="mb-3 d-flex align-items-center">
                            <div class="bg-soft p-2 rounded-circle me-3 text-pink"><i class="bi bi-geo-alt-fill"></i></div>
                            <span>Av. Principal #123, Local 4, Ciudad</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <div class="bg-soft p-2 rounded-circle me-3 text-pink"><i class="bi bi-telephone-fill"></i></div>
                            <span>+57 300 123 4567</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <div class="bg-soft p-2 rounded-circle me-3 text-pink"><i class="bi bi-clock-fill"></i></div>
                            <span>Lunes a Sábado: 9:00 AM - 7:00 PM</span>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <div class="card card-clean p-4 p-md-5 shadow-sm border-0">
                        <h4 class="fw-bold text-dark mb-4">Envíanos un Mensaje</h4>
                        <form>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Tu Nombre</label>
                                <input type="text" class="form-control form-control-clean" placeholder="Ej. Sofía Martínez">
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Teléfono / WhatsApp</label>
                                <input type="text" class="form-control form-control-clean" placeholder="Ej. 3001234567">
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Mensaje o Servicio</label>
                                <textarea class="form-control form-control-clean" rows="3" placeholder="Hola, me gustaría agendar una cita para..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-pink w-100 py-3 fw-bold rounded-pill shadow-sm mt-2">Enviar Mensaje</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white text-dark py-4 border-top border-light">
        <%- include('../partials/footer'); %>
    </footer>

    <!-- Carrito y lógica global -->
    <script src="/js/carrito.js"></script>

</body>
</html>