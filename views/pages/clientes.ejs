<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body class="container">

    <header>
        <%- include('../partials/header'); %>
    </header>

    <main>
        <div class="jumbotron">
            <h1>Clientes</h1>

            <% if (typeof mensaje !=='undefined' && mensaje) { %>
                <div class="alert alert-danger">
                    <%= mensaje %>
                </div>
            <% } %>

                    <table id="tablita" class="table table-dark table-hover" border="2px">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% clientes.forEach(function(cliente) { %>
                                <tr>
                                    <td>
                                        <%= cliente.nombre %>
                                    </td>
                                    <td>
                                        <%= cliente.email %>
                                    </td>
                                    <td>
                                        <%= cliente.telefono %>
                                    </td>

                                    <td>
                                        <button
                                            onclick="consultar('<%= cliente.nombre %>', '<%= cliente.email %>', '<%= cliente.telefono %>')"
                                            type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                                            data-bs-target="#consultar">
                                            Ver detalle
                                        </button>

                                        <button
                                            onclick="actualizar('<%= cliente._id %>', '<%= cliente.nombre %>', '<%= cliente.email %>', '<%= cliente.telefono %>')"
                                            type="button" class="btn btn-outline-warning" data-bs-toggle="modal"
                                            data-bs-target="#actualizar">
                                            Editar
                                        </button>

                                        <button
                                            onclick="eliminar('<%= cliente._id %>', '<%= cliente.nombre %>', '<%= cliente.email %>', '<%= cliente.telefono %>')"
                                            type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                            data-bs-target="#eliminar">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
        </div>
    </main>

    <!-- MODAL CONSULTAR -->
    <div class="modal" id="consultar">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title" style="color: black;">Detalles del Cliente</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" style="color: black;">
                    <p><strong>Nombre:</strong> <span id="nombreC"></span></p>
                    <p><strong>Email:</strong> <span id="emailC"></span></p>
                    <p><strong>Teléfono:</strong> <span id="telefonoC"></span></p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- MODAL ACTUALIZAR -->
    <div class="modal" id="actualizar">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title" style="color: black;">Actualizar Cliente</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="formActualizar" method="POST">
                    <div class="modal-body" style="color: black;">

                        <input type="hidden" id="idA" name="id">
                        <input type="hidden" name="_method" value="PUT">

                        <p>
                            Nombre:
                            <input id="nombreA" name="nombre" class="form-control">
                        </p>

                        <p>
                            Email:
                            <input id="emailA" name="email" class="form-control">
                        </p>

                        <p>
                            Teléfono:
                            <input id="telefonoA" name="telefono" class="form-control">
                        </p>

                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">
                            Actualizar
                        </button>

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- MODAL ELIMINAR -->
    <div class="modal" id="eliminar">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title" style="color: black;">Eliminar Cliente</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="formEliminar" method="POST">

                    <input type="hidden" name="_method" value="DELETE">

                    <div class="modal-body" style="color: black;">
                        <p>¿Seguro que deseas eliminar este cliente?</p>

                        <p><strong>Nombre:</strong> <span id="nombreE"></span></p>
                        <p><strong>Email:</strong> <span id="emailE"></span></p>
                        <p><strong>Teléfono:</strong> <span id="telefonoE"></span></p>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">
                            Confirmar eliminación
                        </button>

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <script>
        function consultar(nombre, email, telefono) {
            document.getElementById("nombreC").textContent = nombre;
            document.getElementById("emailC").textContent = email;
            document.getElementById("telefonoC").textContent = telefono;
        }

        function actualizar(id, nombre, email, telefono) {
            document.getElementById("idA").value = id;
            document.getElementById("nombreA").value = nombre;
            document.getElementById("emailA").value = email;
            document.getElementById("telefonoA").value = telefono;

            document.getElementById("formActualizar").action =
                "/api/v1/clientes/" + id + "?_method=PUT";
        }

        function eliminar(id, nombre, email, telefono) {
            document.getElementById("nombreE").textContent = nombre;
            document.getElementById("emailE").textContent = email;
            document.getElementById("telefonoE").textContent = telefono;

            document.getElementById("formEliminar").action =
                "/api/v1/clientes/" + id + "?_method=DELETE";
        }
    </script>

</body>

</html>