<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head'); %>
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

    <header>
        <%- include('../partials/header'); %>
    </header>

    <main class="container py-5">

        <!-- Título de la Sección -->
        <div class="row mb-5 text-center">
            <div class="col-12">
                <h2 class="fw-bold text-catalogue-title">Catálogo Exclusivo</h2>
                <p class="text-muted">Encuentra tus productos favoritos diseñados especialmente para ti</p>
            </div>
        </div>

        <!-- Cuadrícula de Productos -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            <% productos.forEach(producto => { %>
                <div class="col">
                    <div class="card h-100 product-card border-0 shadow-sm">
                        
                        <!-- Contenedor de Imagen Proporcional (Evita que se vea mocha) -->
                        <div class="product-img-wrapper position-relative bg-light">
                            <img src="<%= producto.imagen %>"
                                 class="card-img-top product-img"
                                 alt="<%= producto.nombre %>">
                            <% if (producto.stock === 0) { %>
                                <span class="badge bg-secondary position-absolute top-0 end-0 m-3">Agotado</span>
                            <% } %>
                        </div>

                        <!-- Cuerpo de la Tarjeta -->
                        <div class="card-body d-flex flex-column text-center">
                            <h5 class="card-title fw-semibold text-dark mb-2"><%= producto.nombre %></h5>
                            
                            <h4 class="card-text text-price fw-bold mb-4">
                                $ <%= producto.precio.toLocaleString() %>
                            </h4>

                        <!-- Botón Agregar al Carrito (Sin stock visible) -->
                         
                        <button
                            class="btn btn-pink-custom mt-auto w-100 py-2 text-white fw-medium shadow-sm add-to-cart-btn"
                            data-id="<%= producto._id %>"
                            data-nombre="<%= producto.nombre %>"
                            data-precio="<%= producto.precio %>"
                            data-imagen="<%= producto.imagen %>"
                            data-stock="<%= producto.stock %>"
                            <%= producto.stock === 0 ? 'disabled' : '' %>>
                            <i class="bi bi-bag-heart me-2"></i> Agregar al carrito
                        </button>
                        </div>

                    </div>
                </div>
            <% }) %>
        </div>

    </main>

    

    <!-- Modal Login -->
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Iniciar sesión</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Correo</label>
                        <input type="email" class="form-control" id="correo">
                    </div>
                    <div class="mb-3">
                        <label>Contraseña</label>
                        <input type="password" class="form-control" id="password">
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary bg-pink-custom border-0" onclick="iniciarSesion()">Ingresar</button>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <!-- Script de Carrito -->
    <script src="/js/carrito.js"></script>


</body>
</html>